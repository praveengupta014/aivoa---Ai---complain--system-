GROQ_API_KEY=your_groq_api_key_here

# Models
GROQ_EXTRACTION_MODEL=llama-3.1-8b-instant
GROQ_REASONING_MODEL=llama-3.3-70b-versatile

# Database (Postgres by default; MySQL connection string also works with the
# mysql+pymysql driver if you swap it in database.py)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/aivoa_complaints
# CORS
FRONTEND_ORIGIN=http://localhost:5173
